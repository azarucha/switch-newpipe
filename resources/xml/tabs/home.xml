<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="26"
    paddingLeft="34"
    paddingRight="16">

    <brls:Label
        id="home/status"
        width="auto"
        height="auto"
        text=""
        fontSize="17"
        textColor="#F1F1F1"
        marginBottom="14" />

    <brls:Box
        id="home/chips"
        width="auto"
        height="auto"
        axis="row"
        marginBottom="18" />

    <brls:ProgressSpinner
        id="home/spinner"
        width="auto"
        height="80"
        visibility="gone" />

    <brls:ScrollingFrame
        id="home/scroll"
        width="auto"
        grow="1.0">

        <brls:Box
            id="home/grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="4"
            paddingBottom="24" />

    </brls:ScrollingFrame>

</brls:Box>
