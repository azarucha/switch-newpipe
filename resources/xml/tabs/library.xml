<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="26"
    paddingLeft="34"
    paddingRight="16">

    <brls:Label
        id="library/status"
        width="auto"
        height="auto"
        text=""
        fontSize="26"
        textColor="#F1F1F1"
        marginBottom="14" />

    <brls:Box
        id="library/chips"
        width="auto"
        height="auto"
        axis="row"
        marginBottom="16" />

    <brls:Label
        id="library/body"
        width="auto"
        height="auto"
        lineHeight="1.5"
        text=""
        fontSize="15"
        textColor="#AAAAAA"
        marginBottom="14" />

    <brls:ProgressSpinner
        id="library/spinner"
        width="auto"
        height="80"
        visibility="gone" />

    <brls:ScrollingFrame
        id="library/scroll"
        width="auto"
        grow="1.0">

        <brls:Box
            id="library/grid"
            width="auto"
            height="auto"
            axis="column"
            paddingTop="4"
            paddingBottom="24" />

    </brls:ScrollingFrame>

</brls:Box>
