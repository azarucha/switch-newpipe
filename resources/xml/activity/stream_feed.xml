<brls:AppletFrame
    headerHidden="true"
    footerHidden="false">
    <brls:Box
        width="100%"
        height="100%"
        axis="column"
        paddingTop="26"
        paddingLeft="34"
        paddingRight="24">

        <brls:Label
            id="feed/status"
            width="auto"
            height="auto"
            text=""
            fontSize="26"
            textColor="#F1F1F1"
            marginBottom="6" />

        <brls:Label
            id="feed/subtitle"
            width="auto"
            height="auto"
            text=""
            fontSize="15"
            textColor="#AAAAAA"
            marginBottom="12" />

        <brls:ScrollingFrame
            id="feed/scroll"
            width="auto"
            grow="1.0">

            <brls:Box
                id="feed/grid"
                width="auto"
                height="auto"
                axis="column" />

        </brls:ScrollingFrame>
    </brls:Box>
</brls:AppletFrame>
