<brls:AppletFrame
    headerHidden="true"
    footerHidden="false">
    <brls:Box
        width="100%"
        height="100%"
        axis="column"
        paddingTop="30"
        paddingLeft="40"
        paddingRight="40">

        <brls:Box
            width="auto"
            height="auto"
            axis="row">

            <brls:Box
                width="480"
                height="270"
                cornerRadius="16"
                backgroundColor="#272727">

                <brls:Image
                    id="detail/thumbnail"
                    width="480"
                    height="270"
                    scalingType="fill"
                    cornerRadius="16" />

                <brls:Box
                    id="detail/badge"
                    width="auto"
                    height="auto"
                    positionType="absolute"
                    positionRight="10"
                    positionBottom="10"
                    paddingLeft="7"
                    paddingRight="7"
                    paddingTop="2"
                    paddingBottom="2"
                    cornerRadius="4"
                    backgroundColor="#000000CC">

                    <brls:Label
                        id="detail/badge_label"
                        width="auto"
                        height="auto"
                        fontSize="15"
                        singleLine="true"
                        textColor="#FFFFFF" />
                </brls:Box>
            </brls:Box>

            <brls:Box
                width="690"
                height="auto"
                axis="column"
                marginLeft="30">

                <brls:Label
                    id="detail/title"
                    width="690"
                    height="auto"
                    text=""
                    fontSize="24"
                    lineHeight="1.3"
                    textColor="#F1F1F1" />

                <brls:Label
                    id="detail/channel"
                    width="690"
                    height="auto"
                    text=""
                    marginTop="12"
                    fontSize="17"
                    singleLine="true"
                    textColor="#F1F1F1" />

                <brls:Label
                    id="detail/meta"
                    width="690"
                    height="auto"
                    text=""
                    marginTop="4"
                    fontSize="15"
                    singleLine="true"
                    textColor="#AAAAAA" />

                <brls:Box
                    id="detail/actions"
                    width="auto"
                    height="auto"
                    axis="row"
                    marginTop="22" />

                <brls:Box
                    id="detail/actions_more"
                    width="auto"
                    height="auto"
                    axis="row"
                    marginTop="12" />
            </brls:Box>
        </brls:Box>

        <brls:ProgressSpinner
            id="detail/spinner"
            width="auto"
            height="60"
            visibility="gone" />

        <brls:Box
            width="auto"
            height="auto"
            grow="1"
            axis="column"
            marginTop="24"
            marginBottom="12"
            padding="18"
            cornerRadius="14"
            backgroundColor="#272727">

            <brls:Label
                id="detail/body"
                width="auto"
                height="auto"
                text=""
                lineHeight="1.5"
                fontSize="15"
                textColor="#D9D9D9" />
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
