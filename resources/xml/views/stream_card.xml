<brls:Box
    width="350"
    height="auto"
    axis="column"
    marginRight="18"
    padding="6"
    focusable="true"
    cornerRadius="14"
    highlightCornerRadius="14"
    hideHighlightBackground="true">

    <brls:Box
        id="stream/thumb_box"
        width="338"
        height="190"
        cornerRadius="12"
        backgroundColor="#272727">

        <brls:Image
            id="stream/thumbnail"
            width="338"
            height="190"
            scalingType="fill"
            cornerRadius="12" />

        <brls:Box
            id="stream/badge"
            width="auto"
            height="auto"
            positionType="absolute"
            positionRight="8"
            positionBottom="8"
            paddingLeft="6"
            paddingRight="6"
            paddingTop="2"
            paddingBottom="2"
            cornerRadius="4"
            backgroundColor="#000000CC">

            <brls:Label
                id="stream/badge_label"
                width="auto"
                height="auto"
                fontSize="13"
                singleLine="true"
                textColor="#FFFFFF" />
        </brls:Box>
    </brls:Box>

    <brls:Label
        id="stream/title"
        width="338"
        height="auto"
        marginTop="10"
        fontSize="16"
        lineHeight="1.3"
        textColor="#F1F1F1" />

    <brls:Label
        id="stream/channel"
        width="338"
        height="auto"
        marginTop="4"
        fontSize="13"
        singleLine="true"
        textColor="#AAAAAA" />

    <brls:Label
        id="stream/meta"
        width="338"
        height="auto"
        marginTop="1"
        marginBottom="4"
        fontSize="13"
        singleLine="true"
        textColor="#AAAAAA" />

</brls:Box>
